{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DBX MySQL",
  "version": "0.6.36",
  "identifier": "com.qqwwww8741.dbx.mysql",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "DBX MySQL",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        },
        "hiddenTitle": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "targets": "all",
    "createUpdaterArtifacts": false,
    "fileAssociations": [
      {
        "ext": [
          "sql"
        ],
        "name": "SQL Script",
        "description": "SQL script",
        "role": "Editor",
        "mimeType": "application/sql"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/DBX.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/DBX.desktop"
      }
    },
    "macOS": {
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese",
          "TradChinese"
        ],
        "template": "windows/nsis/installer.nsi"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "dbx"
        ]
      }
    }
  }
}
